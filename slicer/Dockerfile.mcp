FROM python:3.12-slim-bookworm

WORKDIR /app
COPY requirements-mcp.txt .
RUN pip install --no-cache-dir -r requirements-mcp.txt
COPY mcp_service.py .
COPY mcp_selftest.py .
COPY connector_auth.py .

ENV PYTHONUNBUFFERED=1
EXPOSE 8000
CMD ["sh","-c","python mcp_selftest.py && uvicorn mcp_service:app --host 0.0.0.0 --port ${PORT:-8000}"]

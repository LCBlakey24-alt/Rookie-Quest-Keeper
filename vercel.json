{
  "buildCommand": "yarn build",
  "outputDirectory": "build",
  "installCommand": "yarn install",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "*": false
    }
  },
  "env": {
    "NODE_OPTIONS": "--max-old-space-size=3072",
    "DISABLE_ESLINT_PLUGIN": "true",
    "CI": "true",
    "VERCEL": "1",
    "NODE_ENV": "production"
  }
}
{
  "name": "rookie-quest-keeper-desktop",
  "version": "0.5.0",
  "private": true,
  "description": "Offline-first Windows desktop edition of Rookie Quest Keeper",
  "main": "bootstrap.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "test": "node --test",
    "dist:portable": "electron-builder --win portable --x64 --publish never"
  },
  "devDependencies": {
    "electron": "44.6.0",
    "electron-builder": "26.15.3",
    "yaml": "2.9.1"
  },
  "build": {
    "appId": "com.rookiequest.keeper.desktop",
    "productName": "Rookie Quest Keeper",
    "asar": true,
    "files": [
      "bootstrap.js",
      "programTrust.json",
      "signedProgramPackage.js",
      "programRelease.js",
      "backup.js",
      "attachmentSafety.js",
      "playerDisplayWindow.js",
      "updates.js",
      "updateSafety.js",
      "workspaceSnapshot.js",
      "workspaceRestore.js",
      "portableProgramUpdate.js",
      "browserStorage.js",
      "maintenance.js",
      "restoreJournal.js",
      "copiedProfileMigration.js",
      "main.js",
      "rendererProtocol.js",
      "portable.js",
      "preload.js",
      "renderer/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "verifyUpdateCodeSignature": true,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "deleteAppDataOnUninstall": false,
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Rookie Quest Keeper"
    },
    "publish": {
      "provider": "github",
      "owner": "LCBlakey24-alt",
      "repo": "Rookie-Quest-Keeper",
      "releaseType": "draft",
      "tagNamePrefix": "desktop-v"
    },
    "portable": {
      "artifactName": "Rookie Quest Keeper Portable ${version}.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "6.8.10"
  }
}

{
  "name": "rookie-quest-keeper-desktop",
  "version": "0.3.3",
  "private": true,
  "description": "Offline Windows desktop edition of Rookie Quest Keeper",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "release:win": "electron-builder --win nsis --x64 --publish always",
    "test": "node --test"
  },
  "devDependencies": {
    "electron": "44.6.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.rookiequest.keeper.desktop",
    "productName": "Rookie Quest Keeper",
    "asar": true,
    "files": [
      "backup.js",
      "playerDisplayWindow.js",
      "updates.js",
      "main.js",
      "preload.js",
      "renderer/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Rookie Quest Keeper"
    },
    "publish": {
      "provider": "github",
      "owner": "LCBlakey24-alt",
      "repo": "Rookie-Quest-Keeper",
      "releaseType": "draft",
      "tagNamePrefix": "desktop-v"
    }
  },
  "dependencies": {
    "electron-updater": "6.8.10"
  }
}

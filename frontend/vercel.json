{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "feature/**": false,
      "fix/**": false,
      "style/**": false,
      "rebase/**": false,
      "docs/**": false,
      "test/**": false,
      "chore/**": false,
      "refactor/**": false,
      "codex/**": false,
      "claude/**": false
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://rookie-quest-keeper-api.onrender.com/api/:path*"
    }
  ],
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "0"
        }
      ]
    }
  ]
}
